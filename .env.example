# Contact form (Cloudflare Pages Function: functions/api/contact.ts)
#
# Production: set these as encrypted Pages secrets, never in a committed file:
#   npx wrangler pages secret put RESEND_API_KEY --project-name satkarinteriors
#
# Local: copy this file to .dev.vars and run `npm run build && npm run pages:dev`.

# Resend API key with "Sending access" only (https://resend.com/api-keys).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Where enquiries are delivered. Comma-separate multiple inboxes.
CONTACT_EMAIL="satkarinteriors93@gmail.com"

# Sender shown on the email. The domain must be verified in Resend.
FROM_EMAIL="Satkar Interiors Website <enquiries@satkarinteriors.com>"
